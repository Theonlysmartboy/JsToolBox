Namespace Controls.TreeView.Enums

    ''' <summary>
    ''' Determines whether the SmartTreeView displays
    ''' checkbox or radio-button indicators.
    ''' </summary>
    Public Enum SmartTreeViewCheckMode

        ''' <summary>
        ''' No checkbox or radio-button indicator is displayed.
        ''' </summary>
        None

        ''' <summary>
        ''' Display checkbox indicators.
        ''' Multiple nodes may be checked.
        ''' </summary>
        CheckBox

        ''' <summary>
        ''' Display radio-button indicators.
        ''' Only one node may be checked at a time.
        ''' </summary>
        RadioButton

    End Enum
End Namespace